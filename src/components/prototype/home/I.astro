---
// PROTOTYPE I — Install day: scroll through the morning of an install and watch the
// empty room fill. CSS scroll-driven animation; with reduced motion, or in browsers
// without it, the finished room simply shows.
import Garland from '../Garland.astro';
import { PALETTES } from '../garland';
const STEPS = [
  ['7:30', 'We arrive', 'Load in, check the space, lay out the frame.'],
  ['8:15', 'The frame goes up', 'Anchored and weighted. Nothing touches your walls.'],
  ['9:00', 'The garland', 'Built on site, cluster by cluster, in your colours.'],
  ['10:30', 'The details', 'Greenery, small balloons, the final shape.'],
  ['11:00', 'We leave it ready', 'A sweep for every scrap, and it is yours.'],
];
---

<section class="day">
  <header>
    <p class="eyebrow">The morning of</p>
    <h1>An installation, from empty room to finished.</h1>
  </header>
  <div class="track">
    <div class="stage">
      <div class="room" aria-hidden="true">
        <div class="window"></div>
        <div class="table"></div>
        <div class="fill"><Garland palette={PALETTES.celebration} seed={6} width={900} height={200} sag={0.35} /></div>
      </div>
    </div>
    <ol class="steps">
      {STEPS.map(([t, h, d]) => (
        <li><span class="t">{t}</span><h2>{h}</h2><p>{d}</p></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .day { padding: 48px max(16px, env(safe-area-inset-left, 0px)) 140px; max-width: 1080px; margin: 0 auto; display: grid; gap: 24px; }
  header h1, header p { margin: 0; }
  .track { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: start; }
  .stage { position: sticky; top: 24px; }
  .room { position: relative; aspect-ratio: 4 / 3; background: var(--surface); border: 1px solid var(--line); overflow: hidden; }
  .window { position: absolute; top: 12%; right: 10%; width: 22%; height: 34%; border: 1px solid var(--line); background: linear-gradient(var(--ground), var(--surface)); }
  .table { position: absolute; left: 12%; right: 12%; bottom: 18%; height: 3%; background: var(--ink-muted); opacity: 0.5; }
  .fill { position: absolute; left: 6%; right: 6%; top: 34%; clip-path: inset(0 0 0 0); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 30vh; padding-bottom: 20vh; }
  .steps li { display: grid; gap: 4px; }
  .t { font-family: var(--font-display); font-size: 1.6rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .steps h2 { margin: 0; font-size: var(--step-1); }
  .steps p { margin: 0; color: var(--ink-muted); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .track { view-timeline: --install block; }
      .fill { animation: build linear both; animation-timeline: --install; animation-range: entry 30% exit 70%; }
      @keyframes build { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
    }
  }
  @media (max-width: 720px) {
    .track { grid-template-columns: 1fr; }
    .stage { top: 8px; z-index: 1; }
    .steps { gap: 40vh; }
  }
</style>
