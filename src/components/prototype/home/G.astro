---
// PROTOTYPE G — Tide table: Saturdays laid out like a tide chart, so "is my date
// free?" is answered before anyone asks. EXAMPLE DATA ONLY; she'd update it by hand.
type Status = 'open' | 'held' | 'booked';
const MONTHS: { m: string; days: [number, Status][] }[] = [
  { m: 'May', days: [[2, 'open'], [9, 'open'], [16, 'held'], [23, 'booked'], [30, 'open']] },
  { m: 'June', days: [[6, 'booked'], [13, 'open'], [20, 'booked'], [27, 'held']] },
  { m: 'July', days: [[4, 'booked'], [11, 'open'], [18, 'booked'], [25, 'booked']] },
  { m: 'August', days: [[1, 'held'], [8, 'booked'], [15, 'open'], [22, 'booked'], [29, 'open']] },
  { m: 'September', days: [[5, 'booked'], [12, 'open'], [19, 'open'], [26, 'open']] },
];
const open = MONTHS.flatMap((m) => m.days).filter(([, s]) => s === 'open').length;
---

<section class="tide">
  <header>
    <p class="eyebrow">Saturdays · summer 2027 · <em>example data</em></p>
    <h1>{open} Saturdays left this summer.</h1>
    <p>Weekdays are mostly open. Read it like a tide table: the low marks are free.</p>
  </header>
  <div class="table-wrap">
    <table>
      <caption class="sr">Saturday availability, May to September 2027</caption>
      <thead><tr><th scope="col">Month</th><th scope="col" colspan="5">Saturdays</th></tr></thead>
      <tbody>
        {MONTHS.map((month) => (
          <tr>
            <th scope="row">{month.m}</th>
            {month.days.map(([d, s]) => (
              <td class={s}>
                <span class="d">{d}</span>
                <span class="mark" aria-hidden="true"></span>
                <span class="s">{s === 'open' ? 'Open' : s === 'held' ? 'On hold' : 'Booked'}</span>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="legend"><span class="k open"></span>Open <span class="k held"></span>On hold <span class="k booked"></span>Booked</p>
  <a class="button" href="/enquire">Ask about a date</a>
</section>

<style>
  .tide { padding: 48px max(16px, env(safe-area-inset-left, 0px)) 140px; max-width: 960px; margin: 0 auto; display: grid; gap: 20px; }
  header { display: grid; gap: 8px; }
  header h1, header p { margin: 0; }
  header p:last-child { color: var(--ink-muted); }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; min-width: 520px; font-variant-numeric: tabular-nums; }
  th, td { border-top: 1px solid var(--line); padding: 12px 8px; text-align: left; vertical-align: bottom; }
  thead th { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); font-weight: 500; }
  tbody th { font-family: var(--font-display); font-weight: 400; font-size: 1.1rem; }
  td { display: table-cell; }
  td .d { display: block; font-family: var(--font-display); font-size: 1.4rem; }
  td .mark { display: block; height: 4px; width: 32px; margin: 6px 0; background: var(--line); }
  td.open .mark { background: var(--support); }
  td.held .mark { background: repeating-linear-gradient(90deg, var(--support) 0 4px, transparent 4px 7px); }
  td .s { font-size: 0.78rem; color: var(--ink-muted); }
  td.booked .d { color: var(--ink-muted); text-decoration: line-through; text-decoration-thickness: 1px; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: 0.85rem; color: var(--ink-muted); margin: 0; }
  .k { display: inline-block; width: 18px; height: 4px; background: var(--line); margin-right: -8px; }
  .k.open { background: var(--support); }
  .k.held { background: repeating-linear-gradient(90deg, var(--support) 0 4px, transparent 4px 7px); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .button { justify-self: start; }
</style>
