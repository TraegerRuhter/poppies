---
// PROTOTYPE — throwaway. A floating bar to flip between variants: a dropdown,
// arrows, or ←/→.
interface Props {
  variants: { key: string; name: string }[];
  current: string;
}
const { variants, current } = Astro.props;
const idx = variants.findIndex((v) => v.key === current);
const here = variants[idx];
---

<nav class="proto-switcher" aria-label="Prototype variants" data-keys={variants.map((v) => v.key).join(',')} data-current={current}>
  <button type="button" data-step="-1" aria-label="Previous variant">←</button>
  <label class="sr" for="proto-pick">Choose a sketch</label>
  <select id="proto-pick">
    {variants.map((v, i) => (
      <option value={v.key} selected={v.key === current}>{v.key} — {v.name} ({i + 1}/{variants.length})</option>
    ))}
  </select>
  <button type="button" data-step="1" aria-label="Next variant">→</button>
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('.proto-switcher')!;
  const keys = bar.dataset.keys!.split(',');
  const go = (step: number) => {
    const i = keys.indexOf(bar.dataset.current!);
    const next = keys[(i + step + keys.length) % keys.length];
    const url = new URL(location.href);
    url.searchParams.set('variant', next);
    location.assign(url);
  };
  bar.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.step))));
  bar.querySelector<HTMLSelectElement>('#proto-pick')!.addEventListener('change', (e) => {
    const url = new URL(location.href);
    url.searchParams.set('variant', (e.target as HTMLSelectElement).value);
    location.assign(url);
  });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select, [contenteditable]')) return;
    if (e.key === 'ArrowLeft') go(-1);
    if (e.key === 'ArrowRight') go(1);
  });
</script>

<style>
  .proto-switcher {
    position: fixed; left: 50%; transform: translateX(-50%);
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    display: flex; align-items: center; gap: 4px; padding: 6px;
    background: #1d1b19; color: #f6f2ec; border-radius: 999px; z-index: 100;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3); font: 500 14px/1 system-ui, sans-serif;
    max-width: calc(100vw - 32px);
  }
  .proto-switcher select {
    font: inherit; color: inherit; background: transparent; border: 0; padding: 8px 4px;
    max-width: 62vw; cursor: pointer; text-overflow: ellipsis;
  }
  .proto-switcher select:focus-visible { outline: 2px solid #f6f2ec; outline-offset: 2px; border-radius: 6px; }
  .proto-switcher option { color: #1d1b19; background: #f6f2ec; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .proto-switcher button { background: transparent; color: inherit; border: 0; font: inherit; padding: 10px 14px; border-radius: 999px; cursor: pointer; }
  .proto-switcher button:hover, .proto-switcher button:focus-visible { background: rgba(255, 255, 255, 0.15); outline: none; }
</style>
