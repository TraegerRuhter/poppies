---
// The service menu, from content. Placeholder entries render in development
// only, so the live site never states a service the offering model has not
// produced (website ticket 05).
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).filter(
  (s) => s.data.status === 'live' || import.meta.env.DEV,
);
---

{services.length > 0 && (
  <ul class="services">
    {services.map((s) => (
      <li class:list={{ placeholder: s.data.status === 'placeholder' }}>
        <h3>{s.data.title}</h3>
        <p>{s.data.summary}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .services { list-style: none; padding: 0; margin: 0 0 var(--space-3); display: grid; gap: var(--space-2); }
  .services li { border: 1px solid var(--line); background: var(--surface); padding: var(--space-3); }
  .services li.placeholder { border-style: dashed; }
  .services h3 { margin-bottom: 4px; }
  .services p { margin: 0; color: var(--ink-muted); }
</style>
