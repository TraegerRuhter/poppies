---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { frameFor } from '../lib/photos';
import { ogImage } from '../lib/og';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing content: src/content/pages/about.md');
const { Content } = await render(page);
// For a business that comes into your home or venue, "who is this person" is a
// live question (decisions §7), so the portrait is a shot-list slot.
const portrait = await frameFor('about-portrait');
---

<Base
  title={page.data.eyebrow ?? page.data.title}
  description={page.data.description ?? page.data.title}
  image={await ogImage(portrait)}
>
  <section class="about wrap">
    <div class="about-frame rise">
      <Frame frame={portrait} sizes="(min-width: 1080px) 440px, 100vw" eager />
    </div>
    <div class="about-text">
      {page.data.eyebrow && <p class="eyebrow rise">{page.data.eyebrow}</p>}
      <h1 class="rise">{page.data.title}</h1>
      <div class="prose rise"><Content /></div>
      <a class="button" href="/enquire">Start an enquiry</a>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-5);
  }
  .prose :global(p) { color: var(--ink-muted); max-width: 34rem; }
  .button {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 14px 28px;
    background: var(--ink);
    color: var(--ground);
    text-decoration: none;
    font-weight: 500;
    border-radius: 2px;
  }
  .about-text .rise:nth-child(2) { animation-delay: 80ms; }
  .about-text .rise:nth-child(3) { animation-delay: 160ms; }
  @media (max-width: 720px) {
    .about { grid-template-columns: 1fr; gap: var(--space-4); padding-top: var(--space-4); }
    .about-frame { max-width: 320px; }
  }
</style>
