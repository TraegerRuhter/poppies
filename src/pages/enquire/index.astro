---
import Base from '../../layouts/Base.astro';
import { EVENT_TYPES, FIELDS, HONEYPOT, MAX_FIELD_LENGTH } from '../../lib/enquiry';

// On demand, so the paths can link in with ?event= and a bounced submission
// can say what was missing and show what was typed, with no client-side
// JavaScript.
export const prerender = false;

// Where enquiries come from, so effort goes to the channels that book work.
const SOURCES = [
  'Google',
  'Instagram',
  'Facebook',
  'Nextdoor',
  'A venue',
  'A planner or photographer',
  'A friend',
  'Saw one of our installations',
  'Somewhere else',
];
const LABELS: Record<string, string> = Object.fromEntries(
  FIELDS.flatMap((f) => (f.missing ? [[f.key, f.missing]] : [])),
);

const params = Astro.url.searchParams;
// What a bounced submission carried back, keyed by field; empty on a fresh visit.
const typed = Object.fromEntries(FIELDS.map((f) => [f.key, params.get(f.key) ?? '']));
const event = typed.eventType || params.get('event');
const preselected = EVENT_TYPES.some((t) => t.value === event) ? event : null;
const missing = (params.get('missing') ?? '').split(',').filter((key) => key in LABELS);
---

<Base
  title="Enquire"
  description="Tell us about your celebration or wedding on the Oregon coast — the date, the place and roughly what you have in mind."
>
  <section class="wrap enquire">
    <p class="eyebrow">Enquire</p>
    <h1>Tell us about your day.</h1>
    <p class="intro">A few details help us come back with something useful. We reply to every enquiry.</p>

    {missing.length > 0 && (
      <p class="notice" role="alert">
        We still need {missing.map((key) => LABELS[key]).join(', ')}.
      </p>
    )}

    <form method="post" action="/api/enquiry">
      <label>
        Your name
        <input name="name" value={typed.name} maxlength={MAX_FIELD_LENGTH} autocomplete="name" required />
      </label>
      <label>
        Email
        <input name="email" value={typed.email} maxlength={MAX_FIELD_LENGTH} type="email" autocomplete="email" required />
      </label>
      <label>
        What are you planning?
        <select name="eventType" required>
          {!preselected && <option value="">Choose one</option>}
          {EVENT_TYPES.map((t) => (
            <option value={t.value} selected={t.value === preselected}>{t.label}</option>
          ))}
        </select>
      </label>
      <div class="pair">
        <label>
          Date
          <input name="date" value={typed.date} type="date" required />
          <small>So we can check we're free.</small>
        </label>
        <label>
          Town or venue
          <input name="town" value={typed.town} maxlength={MAX_FIELD_LENGTH} required />
          <small>Travel along the coast changes the quote.</small>
        </label>
      </div>
      <label>
        <span>Roughly how big? <span class="optional">optional</span></span>
        <input name="scale" value={typed.scale} maxlength={MAX_FIELD_LENGTH} placeholder="A garland for the cake table, an arch for the ceremony…" />
      </label>
      <label>
        <span>Colours <span class="optional">optional</span></span>
        <input name="colours" value={typed.colours} maxlength={MAX_FIELD_LENGTH} placeholder="Sage and cream, or “not sure yet”" />
        <small>We'll suggest palettes if you're not sure.</small>
      </label>
      <label>
        <span>Budget, if you have one in mind <span class="optional">optional</span></span>
        <input name="budget" value={typed.budget} maxlength={MAX_FIELD_LENGTH} placeholder="A rough figure or range is plenty" />
        <small>It helps us suggest something that fits, rather than start too big.</small>
      </label>
      <label>
        <span>Anyone with a latex allergy? <span class="optional">optional</span></span>
        <input name="latex" value={typed.latex} maxlength={MAX_FIELD_LENGTH} placeholder="Leave blank if not" />
        <small>Most balloons are natural latex. Tell us and we'll plan around it.</small>
      </label>
      <label>
        <span>How did you hear about us? <span class="optional">optional</span></span>
        <select name="source">
          <option value="">Choose one</option>
          {SOURCES.map((s) => <option selected={s === typed.source}>{s}</option>)}
        </select>
      </label>

      <!-- Honeypot: hidden from people and assistive tech; bots fill it. -->
      <div class="hp" aria-hidden="true">
        <label>Leave this empty <input name={HONEYPOT} tabindex="-1" autocomplete="off" /></label>
      </div>

      <button class="button" type="submit">Send enquiry</button>
    </form>
  </section>
</Base>

<style>
  .enquire { padding-block: var(--space-5); max-width: 40rem; }
  .intro { color: var(--ink-muted); margin-bottom: var(--space-4); }
  .notice {
    border-left: 3px solid var(--accent);
    background: var(--surface);
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-3);
  }
  form { display: grid; gap: var(--space-3); }
  label { display: grid; gap: 6px; font-size: var(--step--1); font-weight: 500; }
  .optional { font-weight: 400; color: var(--ink-muted); }
  small { font-weight: 400; color: var(--ink-muted); font-size: 0.8rem; }
  input, select {
    font: inherit;
    font-size: var(--step-0);
    font-weight: 400;
    padding: 12px 14px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    border-radius: 2px;
  }
  input:focus-visible, select:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  @media (max-width: 520px) { .pair { grid-template-columns: 1fr; } }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  button { justify-self: start; margin-top: 0; }
</style>
