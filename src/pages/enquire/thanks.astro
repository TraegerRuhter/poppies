---
import Base from '../../layouts/Base.astro';
---

<Base title="Thank you" description="Your enquiry has been sent." noindex>
  <section class="wrap note">
    <p class="eyebrow">Enquiry sent</p>
    <h1 class="rise">Thank you.</h1>
    <p class="rise">We've got your details and will reply by email, usually within a couple of days.</p>
    <p><a href="/">Back to the home page</a></p>
  </section>
</Base>

<style>
  .note { padding-block: var(--space-5); max-width: 40rem; }
  .note p { color: var(--ink-muted); }
</style>
