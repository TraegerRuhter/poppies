---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { site } from '../site.config';

interface Props {
  title?: string;
  temperature?: 'warm' | 'cool';
  /** Keep a working page (e.g. the shot list) out of search results. */
  noindex?: boolean;
}

const { title, temperature, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const area = await getEntry('serviceArea', 'service-area');
if (!area) throw new Error('Missing content: src/content/service-area.yaml');
const towns = area.data.towns;
---

<!doctype html>
<html lang="en" data-temperature={temperature}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/"><span class="mark" aria-hidden="true"></span>{site.name}</a>
        <nav aria-label="Main">
          <a href="/celebrations">Celebrations</a>
          <a href="/weddings">Weddings</a>
          <a href="/about">About</a>
          <a href="/enquire">Enquire</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="area">
          Balloon installations on the Oregon coast — {towns.slice(0, -1).join(', ')}{towns.length > 1 ? ' and ' : ''}{towns.at(-1)}.
        </p>
        <p class="small">
          © {new Date().getFullYear()} {site.name} · <a href="/about">About</a> · <a href="/enquire">Enquire</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .site-header .wrap {
    padding-block: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  nav { display: flex; gap: var(--space-3); font-size: var(--step--1); }
  nav a { color: var(--ink-muted); text-decoration: none; }
  nav a:hover { color: var(--ink); }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-decoration: none;
  }
  /* The poppy, as a single small dot of accent. */
  .mark {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .site-footer .wrap { padding-block: var(--space-4); display: grid; gap: var(--space-1); }
  .site-footer p { margin: 0; }
  .site-footer .area { color: var(--ink); max-width: 40rem; }
  .site-footer a { color: inherit; }
</style>
