---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { site } from '../site.config';
import { DEFAULT_OG } from '../lib/og';

interface Props {
  title?: string;
  /** Search-result and share-preview text. */
  description: string;
  /** Share image path (see src/lib/og.ts); defaults to the text-free fallback. */
  image?: string;
  /** Mark this page as the business's home, with LocalBusiness structured data. */
  localBusiness?: boolean;
  temperature?: 'warm' | 'cool';
  /** Keep a working page (e.g. the shot list) out of search results. */
  noindex?: boolean;
}

const {
  title,
  description,
  image = DEFAULT_OG,
  localBusiness = false,
  temperature,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const area = await getEntry('serviceArea', 'service-area');
if (!area) throw new Error('Missing content: src/content/service-area.yaml');
const towns = area.data.towns;

// Absolute URLs come from the configured site, which is set from the
// environment because the domain is not settled (astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const structuredData = localBusiness && {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description,
  url: new URL('/', Astro.site).href,
  image: imageUrl.href,
  ...(site.email && { email: site.email }),
  areaServed: towns.map((town) => ({ '@type': 'City', name: `${town}, Oregon` })),
};
---

<!doctype html>
<html lang="en" data-temperature={temperature}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/"><span class="mark" aria-hidden="true"></span>{site.name}</a>
        <nav aria-label="Main">
          <a href="/celebrations">Celebrations</a>
          <a href="/weddings">Weddings</a>
          <a href="/about">About</a>
          <a href="/enquire">Enquire</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="area">
          Balloon installations on the Oregon coast — {towns.slice(0, -1).join(', ')}{towns.length > 1 ? ' and ' : ''}{towns.at(-1)}.
        </p>
        <p class="small">
          © {new Date().getFullYear()} {site.name} · <a href="/about">About</a> · <a href="/enquire">Enquire</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .site-header .wrap {
    padding-block: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  nav { display: flex; gap: var(--space-3); font-size: var(--step--1); }
  nav a { color: var(--ink-muted); text-decoration: none; }
  nav a:hover { color: var(--ink); }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-decoration: none;
  }
  /* The poppy, as a single small dot of accent. */
  .mark {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .site-footer .wrap { padding-block: var(--space-4); display: grid; gap: var(--space-1); }
  .site-footer p { margin: 0; }
  .site-footer .area { color: var(--ink); max-width: 40rem; }
  .site-footer a { color: inherit; }
</style>
