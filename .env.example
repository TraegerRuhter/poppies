# Enquiry form (website ticket 02). Set these in Vercel → Settings → Environment
# Variables. Names only — never commit values.

# Resend: an API key, and the sender once the domain is verified in Resend.
# Without ENQUIRY_FROM the form uses Resend's test sender, which can land in spam.
RESEND_API_KEY=
ENQUIRY_FROM=

# Comma-separated: the owner's address and the developer's.
ENQUIRY_TO=

# Airtable mirror. Optional — if unset or failing, enquiries still email.
# The table needs text columns: Name, Email, Date, Town, Event, Scale, Colours,
# Budget, Received.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
